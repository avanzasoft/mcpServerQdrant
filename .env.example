# Copy to `.env` and adjust values.

# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
COLLECTION_NAME=""
QDRANT_SEARCH_LIMIT="10"
QDRANT_READ_ONLY="false"
QDRANT_ALLOW_ARBITRARY_FILTER="false"

# FastMCP server
FASTMCP_HOST="127.0.0.1"
FASTMCP_PORT="8000"

# CSV exports / downloads
FASTMCP_DOCUMENT_ROOT="."
FASTMCP_PUBLIC_BASE_URL="http://127.0.0.1:8000"

# Signed download links (HMAC)
# Use a long random secret in your real `.env` (do NOT commit it).
FASTMCP_DOWNLOADS_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
FASTMCP_DOWNLOADS_TTL_SECONDS="300"
